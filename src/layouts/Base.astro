---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (() => {
        const param = new URLSearchParams(window.location.search).get("scoutTheme");
        const theme =
          param || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light;
        --cp-bg: #f7f4ef;
        --cp-bg-elevated: #fcfbf8;
        --cp-surface: #ffffff;
        --cp-surface-soft: #f5f5f5;
        --cp-border: #dedede;
        --cp-border-strong: #919191;
        --cp-text: #242424;
        --cp-text-muted: #5c5c5c;
        --cp-text-soft: #6f6f6f;
        --cp-accent: #b11f4b;
        --cp-accent-hover: #9a1a41;
        --cp-accent-soft: rgba(177, 31, 75, 0.08);
        --cp-accent-fg: #ffffff;
        --cp-success: #16a34a;
        --cp-danger: #dc2626;
        --cp-warning: #f59e0b;
        --cp-link: #0078d4;
        --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.12);
        --cp-overlay: rgba(255, 255, 255, 0.8);
        --cp-panel: rgba(255, 255, 255, 0.86);
        --cp-panel-strong: rgba(255, 255, 255, 0.96);
        --cp-sheen: rgba(255, 255, 255, 0.55);
        --cp-highlight: rgba(177, 31, 75, 0.12);
        --radius: 0.625rem;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      html[data-theme="dark"] {
        color-scheme: dark;
        --cp-bg: #3d3b3a;
        --cp-bg-elevated: #343231;
        --cp-surface: #292929;
        --cp-surface-soft: #2e2e2e;
        --cp-border: #474747;
        --cp-border-strong: #5f5f5f;
        --cp-text: #dedede;
        --cp-text-muted: #919191;
        --cp-text-soft: #b0b0b0;
        --cp-accent: #fd8ea1;
        --cp-accent-hover: #fb7b91;
        --cp-accent-soft: rgba(253, 142, 161, 0.14);
        --cp-accent-fg: #1a1a1a;
        --cp-success: #4ade80;
        --cp-danger: #f87171;
        --cp-warning: #fbbf24;
        --cp-link: #4da6ff;
        --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
        --cp-overlay: rgba(41, 41, 41, 0.88);
        --cp-panel: rgba(41, 41, 41, 0.72);
        --cp-panel-strong: rgba(41, 41, 41, 0.96);
        --cp-sheen: rgba(255, 255, 255, 0.04);
        --cp-highlight: rgba(253, 142, 161, 0.12);
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      html { background: var(--cp-bg); color: var(--cp-text); }
      body {
        font-family: var(--font-body);
        line-height: 1.5;
        max-width: 52rem;
        margin: 0 auto;
        padding: 4rem 1.25rem;
      }
      header { margin-bottom: 2rem; border-top: 4px solid var(--cp-accent); padding-top: 1.5rem; }
      h1 { margin: 0 0 0.75rem; font-size: clamp(1.5rem, 4vw, 2.25rem); font-family: var(--font-head); letter-spacing: -0.03em; }
      .tagline { margin: 0; color: var(--cp-text-muted); max-width: 42rem; }
      main { padding: clamp(1rem, 4vw, 2rem); background: var(--cp-surface); border: 1px solid var(--cp-border); border-radius: 16px; }

      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: end;
        margin: 0 0 0.75rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.35rem; flex: 1 1 16rem; }
      label { font-size: 0.85rem; font-weight: 600; }
      input {
        padding: 0.6rem 0.7rem;
        border: 1px solid var(--cp-border-strong);
        border-radius: var(--radius);
        font: inherit;
        background: var(--cp-bg-elevated);
        color: var(--cp-text);
        min-width: 0;
      }
      input:focus-visible,
      button:focus-visible,
      a:focus-visible { outline: 2px solid var(--cp-accent); outline-offset: 3px; }
      button {
        padding: 0.6rem 1rem;
        border: 1px solid var(--cp-accent);
        border-radius: var(--radius);
        background: var(--cp-accent);
        color: var(--cp-accent-fg);
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { background: var(--cp-accent-hover); }
      .hint { margin: 0 0 1rem; font-size: 0.8rem; color: var(--cp-text-muted); }
      #bookmark-status { font-size: 0.85rem; color: var(--cp-text-muted); }
      #bookmark-status:empty { display: none; }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0.5rem 0;
      }
      .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }
      .clear {
        background: var(--cp-surface);
        color: var(--cp-text);
        border: 1px solid var(--cp-border);
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .clear:hover, .bookmark .copy:hover { background: var(--cp-accent-soft); border-color: var(--cp-accent); }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 0.9rem;
        border: 1px solid var(--cp-border);
        border-radius: var(--radius);
        background: var(--cp-bg-elevated);
      }
      .bookmark-label { flex: 1 1 16rem; min-width: 0; overflow-wrap: anywhere; white-space: pre-wrap; }
      .bookmark .url { color: var(--cp-link); text-underline-offset: 3px; }
      .bookmark .slug {
        font-family: var(--font-body);
        font-size: 0.85rem;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        background: var(--cp-accent-soft);
        color: var(--cp-accent);
        white-space: nowrap;
      }
      .bookmark .copy {
        background: var(--cp-surface);
        color: var(--cp-text);
        border: 1px solid var(--cp-border);
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .empty {
        margin: 0;
        padding: 1.5rem;
        text-align: center;
        color: var(--cp-text-muted);
        border: 1px dashed var(--cp-border-strong);
        border-radius: var(--radius);
        background: var(--cp-bg-elevated);
      }

      footer { margin-top: 1.5rem; font-size: 0.8rem; color: var(--cp-text-muted); text-align: center; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
