<form id="add-bookmark" onsubmit="event.preventDefault()">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      aria-describedby="bookmark-hint bookmark-status"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="bookmark-hint" class="hint">With or without https:// &mdash; every link gets its own <code>mona-</code> slug.</p>
<p id="bookmark-status" role="status" aria-live="polite"></p>
<noscript><p>Enable JavaScript to save and view bookmarks on this device.</p></noscript>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import { BOOKMARK_SEPARATOR, STORAGE_KEY, generateSlug, normalizeUrl, parseBookmarks } from './bookmarks';
  import type { Bookmark } from './bookmarks';

  const form = document.querySelector<HTMLFormElement>('#add-bookmark');
  const input = document.querySelector<HTMLInputElement>('#url');
  const list = document.querySelector<HTMLUListElement>('#bookmark-list');
  const empty = document.getElementById('empty-state');
  const header = document.getElementById('list-header');
  const status = document.getElementById('bookmark-status');
  const clear = document.getElementById('clear-all');

  if (form && input && list && empty && header && status && clear) {
    let bookmarks: Bookmark[] = [];

    function render() {
      if (!list || !empty || !header) return;
      list.replaceChildren();
      empty.hidden = bookmarks.length > 0;
      header.hidden = bookmarks.length === 0;
      for (const bookmark of bookmarks) {
        const row = document.createElement('li');
        row.className = 'bookmark';
        const link = document.createElement('a');
        link.className = 'url';
        link.href = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = bookmark.url;
        const slug = document.createElement('span');
        slug.className = 'slug';
        slug.textContent = bookmark.slug;
        const label = document.createElement('span');
        label.className = 'bookmark-label';
        label.append(link, document.createTextNode(BOOKMARK_SEPARATOR), slug);
        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'copy';
        copy.textContent = 'Copy';
        copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(bookmark.slug);
            if (status) status.textContent = `Copied ${bookmark.slug}.`;
          } catch {
            if (status) status.textContent = `Could not copy. Select and copy ${bookmark.slug} manually.`;
          }
        });
        row.append(label, copy);
        list.append(row);
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      try {
        const url = normalizeUrl(input.value);
        const seed = crypto.getRandomValues(new Uint32Array(1))[0] % (62 ** 4);
        const next = [...bookmarks, { url, slug: generateSlug(bookmarks, seed) }];
        localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
        bookmarks = next;
        render();
        input.value = '';
        status.textContent = 'Bookmark saved on this device.';
        input.focus();
      } catch (error) {
        status.textContent = error instanceof TypeError
          ? 'Enter a valid website URL, for example example.com.'
          : error instanceof Error ? `Could not save bookmark: ${error.message}` : 'Could not save bookmark.';
      }
    });

    clear.addEventListener('click', () => {
      if (!window.confirm('Clear all saved bookmarks on this device?')) return;
      try {
        localStorage.removeItem(STORAGE_KEY);
        bookmarks = [];
        render();
        status.textContent = 'All bookmarks cleared.';
      } catch {
        status.textContent = 'Could not clear browser storage. Your bookmarks have not been removed.';
      }
    });

    try {
      const saved = parseBookmarks(localStorage.getItem(STORAGE_KEY));
      bookmarks = saved.bookmarks;
      if (saved.recovered) status.textContent = 'Some saved data was invalid. Only valid bookmarks were restored.';
    } catch {
      status.textContent = 'Browser storage is unavailable. Bookmarks cannot be loaded or saved until it is enabled.';
    }
    render();
  }
</script>
